{
  "name": "harmolyn",
  "private": true,
  "version": "1.0.0-rc.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:website": "npm --prefix website run dev",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:website": "npm --prefix website run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:dev": "vite build --mode development",
    "build:protocol": "tsc -p tsconfig.protocol.json",
    "test:protocol": "npm run build:protocol && node ./scripts/run-protocol-tests.mjs",
    "test:browser": "node ./scripts/browser-native-smoke.mjs",
    "test:browser:missing-runtime": "node ./scripts/browser-native-smoke.mjs no-peers",
    "tauri:dev": "node ./scripts/tauri-dev.mjs",
    "tauri:build": "node ./scripts/tauri-build.mjs",
    "build:linux:x64": "node ./scripts/build-linux-x64.mjs",
    "test:browser:all": "node ./scripts/browser-smoke-all.mjs",
    "test:browser:transport": "node ./scripts/native-transport-test.mjs",
    "test:all": "npm run lint && npm run typecheck && npm run build && npm run test && npm run test:browser:all",
    "test:voice:e2e": "node ./scripts/voice-e2e-test.mjs",
    "test:node-switch:e2e": "node ./scripts/node-switch-e2e.mjs",
    "test:browser:ci": "node ./scripts/browser-ci-smoke.mjs",
    "release:version": "node ./scripts/release-version.mjs",
    "release:artifacts": "node ./scripts/release-artifacts.mjs"
  },
  "dependencies": {
