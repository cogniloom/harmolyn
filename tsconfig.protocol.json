{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "outDir": ".generated/protocol-tests",
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "isolatedModules": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/protocol/**/*.ts",
    "src/lib/authPreview.ts",
    "src/lib/browserStorage.ts",
    "src/types.ts",
    "src/config/featureFlags.ts",
    "protocol-tests/**/*.ts"
  ],
  "exclude": [
    "protocol-tests/node-test-compat.d.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
