# Control endpoint the app connects to by default on launch.
# Defaults to https://node.xorein.com when unset. Point this at your hosted
# xorein node's control API (HTTPS; must serve /v1/state, /v1/*, /v1/events and
# allow the app origin via CORS, or be served same-origin as the client).
VITE_XOREIN_CONTROL_ENDPOINT=https://node.xorein.com

# Public URL where this build's source code is published. Harmolyn is AGPL-3.0
# licensed, so network users must be offered the Corresponding Source (§13);
# the in-app About screen links here. Defaults to the upstream repository.
VITE_SOURCE_URL=https://github.com/kylhuk/harmolyn-preview
